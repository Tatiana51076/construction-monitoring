# Пример настроек. Скопируйте в .env
DATABASE_URL=sqlite:///./constructions.db
# Для PostgreSQL:
# DATABASE_URL=postgresql://user:password@db:5432/construction

# Путь к модели YOLO (своя обученная или готовая)
YOLO_MODEL=models/best.pt
CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.45

# Порог для дедупликации между камерами (метры/условные единицы на плане)
DEDUP_DISTANCE=3.0
# Временное окно дедупликации, минуты
DEDUP_WINDOW_MIN=5
